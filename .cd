#!/bin/bash
source run.sh

infos home.leonk.dev
ls | indent "$B_TRIANGLE "
debug $(repeat 14 echo -n 'X')
help .cd | indent "$B_BULLET "

export_dir="docs"

function serve() {
  python -m http.server 8000 -d "$export_dir"
}

function build() {
	. ./scripts/build.sh
}

function run() {
	. ./scripts/hot.sh
}

function setup() {
	sudo npm i -g sass
	sudo npm i -g pug-cli
	sudo pacman -Syu inotify-tools
}
